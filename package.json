{
	"name": "portfolio-v2",
	"version": "1.0.0",
	"description": "",
	"private": true,
	"engines": {
		"node": "^20.9.0 || >=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"format:check": "turbo run format:check",
		"check": "turbo run check",
		"lint:staged": "lint-staged",
		"test": "turbo run test",
		"storybook": "turbo run dev --filter=storybook",
		"storybook:build": "turbo run build --filter=storybook",
		"storybook:test": "turbo run test --filter=storybook",
		"shadcn:init": "turbo run shadcn:init --filter=@repo/ui-components --",
		"shadcn:add": "turbo run shadcn:add --filter=@repo/ui-components --",
		"clean": "turbo run clean && rm -rf node_modules",
		"prepare": "husky"
	},
	"keywords": [],
	"author": "Hanaa Sadoqi",
	"license": "ISC",
	"packageManager": "pnpm@10.33.4",
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@repo/biome-config": "workspace:*",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.2",
		"turbo": "^2.9.9",
		"typescript": "^6.0.3"
	},
	"pnpm": {
		"overrides": {
			"@types/react": "19.2.14",
			"@types/react-dom": "19.2.3",
			"next": "16.2.5",
			"react": "19.2.6",
			"react-dom": "19.2.6",
			"storybook": "10.3.6",
			"tailwindcss": "4.2.4",
			"typescript": "6.0.3",
			"vitest": "3.2.4"
		},
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,tsx,jsx,json,css,md,mdx}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
