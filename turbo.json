{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"clean": {
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "!**/*.stories.{tsx,jsx,mdx}"],
			"outputs": []
		},
		"storybook#build": {
			"outputs": ["storybook-static/**"]
		},
		"web#build": {
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"web#dev": {
			"cache": false,
			"persistent": true
		},
		"web#lint": {},
		"@repo/ui#lint": {},
		"web#format:check": {},
		"storybook#format:check": {},
		"@repo/ui#format:check": {},
		"web#format": {
			"cache": false
		},
		"storybook#format": {
			"cache": false
		},
		"@repo/ui#format": {
			"cache": false
		},
		"web#check": {},
		"storybook#check": {},
		"@repo/ui#check": {},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"storybook#dev": {
			"cache": false,
			"persistent": true
		},
		"@repo/ui#shadcn:init": {
			"cache": false,
			"interactive": true
		},
		"@repo/ui#shadcn:add": {
			"cache": false,
			"interactive": true
		}
	}
}
