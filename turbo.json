{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"clean": {
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "!**/*.stories.{tsx,jsx,mdx}"],
			"outputs": []
		},
		"storybook#build": {
			"outputs": ["storybook-static/**"]
		},
		"web#build": {
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"web#dev": {
			"cache": false,
			"persistent": true
		},
		"web#lint": {},
		"storybook#lint": {},
		"@repo/ui-components#lint": {},
		"@repo/shared-utils#lint": {},
		"@repo/shared-types#lint": {},
		"@repo/ui-hooks#lint": {},
		"@repo/ui-providers#lint": {},
		"web#format:check": {},
		"storybook#format:check": {},
		"@repo/ui-components#format:check": {},
		"@repo/shared-utils#format:check": {},
		"@repo/shared-types#format:check": {},
		"@repo/ui-hooks#format:check": {},
		"@repo/ui-providers#format:check": {},
		"web#format": {
			"cache": false
		},
		"storybook#format": {
			"cache": false
		},
		"@repo/ui-components#format": {
			"cache": false
		},
		"@repo/shared-utils#format": {
			"cache": false
		},
		"@repo/shared-types#format": {
			"cache": false
		},
		"@repo/ui-hooks#format": {
			"cache": false
		},
		"@repo/ui-providers#format": {
			"cache": false
		},
		"web#check": {},
		"storybook#check": {},
		"@repo/ui-components#check": {},
		"@repo/shared-utils#check": {},
		"@repo/shared-types#check": {},
		"@repo/ui-hooks#check": {},
		"@repo/ui-providers#check": {},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"storybook#test": {
			"cache": false
		},
		"storybook#dev": {
			"cache": false,
			"persistent": true
		},
		"@repo/ui-components#shadcn:init": {
			"cache": false,
			"interactive": true
		},
		"@repo/ui-components#shadcn:add": {
			"cache": false,
			"interactive": true
		}
	}
}
