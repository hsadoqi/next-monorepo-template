{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"clean": {
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "!**/*.stories.{tsx,jsx,mdx}"],
			"outputs": []
		},
		"storybook#build": {
			"outputs": ["storybook-static/**"]
		},
		"web#build": {
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"web#dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {},
		"format:check": {},
		"check": {},
		"format": {
			"cache": false
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"storybook#test": {
			"cache": false
		},
		"storybook#dev": {
			"cache": false,
			"persistent": true
		},
		"web#shadcn:init": {
			"cache": false,
			"interactive": true
		},
		"web#shadcn:add": {
			"cache": false,
			"interactive": true
		},
		"@repo/ui-components#shadcn:init": {
			"cache": false,
			"interactive": true
		},
		"@repo/ui-components#shadcn:add": {
			"cache": false,
			"interactive": true
		}
	}
}
