{
	"$schema": "https://turbo.build/schema.json",
    "ui": "tui",
	"tasks": {
        "web#build": {
            "outputs": [
                ".next/**"
            ]
		},
        "web#dev": {
			"cache": false,
			"persistent": true
		},
                "web#lint": {},
                "@repo/ui#lint": {},
                "web#format": {
			"cache": false
		},
        "@repo/ui#format": {
            "cache": false
        },
        "web#check": {},
        "@repo/ui#check": {},
        "web#storybook": {
			"cache": false,
			"persistent": true
        },
        "@repo/ui#shadcn:init": {
            "cache": false,
            "interactive": true
        },
        "@repo/ui#shadcn:add": {
            "cache": false,
            "interactive": true
		}
	}
}
