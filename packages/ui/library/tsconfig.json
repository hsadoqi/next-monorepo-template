{
	"extends": "@repo/typescript-config/base.json",
	"compilerOptions": {
		"rootDir": "../",
		"outDir": "dist",
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"paths": {
			"@/widgets/*": ["./src/widgets/*"],
			"@/*": ["./src/*"],
			"@repo/ui-components": ["../components/src"],
			"@repo/ui-components/*": ["../components/src/*"]
		}
	},
	"include": ["src"]
}
