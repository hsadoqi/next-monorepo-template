{
	"extends": "@repo/typescript-config/base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"types": ["node"],
		"paths": {
			"@/*": ["../web/*"],
			"@repo/ui-components": ["../../packages/ui/components/src/index.ts"],
			"@repo/ui-components/*": ["../../packages/ui/components/src/*"],
			"@repo/ui-library": ["../../packages/ui/library/src/index.ts"],
			"@repo/ui-library/*": ["../../packages/ui/library/src/*"]
		}
	},
	"include": [".storybook/**/*", "src"],
	"exclude": ["**/.private/**"]
}
