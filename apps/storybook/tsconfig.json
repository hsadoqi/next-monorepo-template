{
	"extends": "@repo/typescript-config/base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"types": ["node"],
		"paths": {
			"@/*": ["../web/*"],
			"@repo/ui": ["../../packages/ui/src/index.ts"],
			"@repo/ui/*": ["../../packages/ui/src/*"]
		}
	},
	"include": [
		".storybook/**/*",
		"src/**/*",
		"../web/**/*.stories.*",
		"../../packages/ui/**/*.stories.*"
	]
}
