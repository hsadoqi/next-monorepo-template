{
	"extends": "@repo/typescript-config/base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"types": ["node"],
		"paths": {
			"@/*": ["../web/*"],
			"@repo/ui-components": ["../../packages/ui/components/src/index.ts"],
			"@repo/ui-components/*": ["../../packages/ui/components/src/*"],
			"@repo/ui-showcase": ["../../packages/ui/component-library/src/index.ts"],
			"@repo/ui-showcase/*": ["../../packages/ui/component-library/src/*"]
		}
	},
	"include": [
		".storybook/**/*",
		"src/**/*",
		"../web/**/*.stories.*",
		"../../packages/ui/**/*.stories.*"
	],
	"exclude": ["**/.private/**"]
}
